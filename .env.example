# Local Postgres (embedded): postgresql://postgres:postgres@localhost:5432/wahaj_store?schema=public
# Production (Vercel + Supabase):
# - DATABASE_URL: Transaction pooler on port 6543 with ?pgbouncer=true (automatically normalized in src/lib/db.ts)
# - DIRECT_URL: IPv4 Session pooler on port 5432 (aws-0-<region>.pooler.supabase.com:5432) for prisma migrate deploy on Vercel builds
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wahaj_store?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wahaj_store?schema=public"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@wahaj.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Wahaj Admin"
UPLOAD_MAX_MB="5"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
# Production image storage (Supabase). Leave empty for local-disk uploads in dev.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="wahaj-images"
# Telegram order alerts (optional). Chat ID can also be set from Admin → Settings.
TELEGRAM_BOT_TOKEN=""
# Password reset emails (optional; in local dev links log to server console when unset).
RESEND_API_KEY=""
EMAIL_FROM=""
